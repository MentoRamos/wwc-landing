# /opt/ww-wa-worker/.env  (chmod 600, generated ON the droplet; never commit)
# WA_WORKER_TOKEN: openssl rand -hex 32 (same value later goes to Vercel env)
WA_WORKER_TOKEN=
# The wwc-landing domain: kauaramos.com only rewrites the routes it lists,
# and /api/wa/* is not one of them (claim got 404 there until 25/09).
WA_API_BASE=https://wwc-landing-rho.vercel.app
# dry-run | allowlist | live
WA_MODE=dry-run
# comma-separated, digits only (e.g. 556291731015); required for allowlist mode
WA_ALLOWLIST=
# local kill switch
WA_ENABLED=true
# SAIR: Evolution posts incoming messages to the worker (docker network only).
# openssl rand -hex 24; then ./set-webhook.sh. Empty = no SAIR = no live.
WA_INBOUND_SECRET=
# WA_INBOUND_PORT=8090
# optional tuning (defaults shown)
# WA_POLL_MS=60000
# WA_GAP_MIN_MS=20000
# WA_GAP_MAX_MS=45000
# WA_DAILY_CAP=150
# WA_QUIET_START=21:30
# WA_QUIET_END=08:00
