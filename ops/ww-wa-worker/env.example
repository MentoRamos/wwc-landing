# /opt/ww-wa-worker/.env  (chmod 600, generated ON the droplet; never commit)
# WA_WORKER_TOKEN: openssl rand -hex 32 (same value later goes to Vercel env)
WA_WORKER_TOKEN=
WA_API_BASE=https://kauaramos.com
# dry-run | allowlist | live
WA_MODE=dry-run
# comma-separated, digits only (e.g. 556291731015); required for allowlist mode
WA_ALLOWLIST=
# local kill switch
WA_ENABLED=true
# optional tuning (defaults shown)
# WA_POLL_MS=60000
# WA_GAP_MIN_MS=20000
# WA_GAP_MAX_MS=45000
# WA_DAILY_CAP=150
# WA_QUIET_START=21:30
# WA_QUIET_END=08:00
