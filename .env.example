# Copy to .env.local and fill in. Never commit .env.local.

# Absolute origin this deployment answers on, without a trailing slash.
# Drives metadataBase, canonical URLs and the OAuth redirect.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The event's own domain. When set, requests arriving on this host are served
# the Connect pages and blocked from the rest of the platform.
# Leave empty until the domain is bought and pointed.
EVENT_HOST=

# Supabase — project dedicated to Wealth & Wellness, São Paulo region.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: never expose it to the browser and never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify webhook. The token is the shared secret used to verify the payload.
KIWIFY_WEBHOOK_TOKEN=

# A regua de e-mails do Circle (Fase 7). Sem as duas primeiras o cron responde
# 200 dizendo que pulou, em vez de falhar em silencio.
RESEND_API_KEY=
RESEND_FROM=
# A Vercel manda `Authorization: Bearer $CRON_SECRET` nos cron jobs. Sem ele o
# endpoint recusa todo mundo, inclusive a propria Vercel.
CRON_SECRET=

# Os artigos do Circle. O cron do servidor (OpenClaw) publica em
# POST /api/artigos com `Authorization: Bearer $ARTICLES_INGEST_TOKEN`. O token
# só serve para isso; sem ele configurado o endpoint recusa todo mundo.
ARTICLES_INGEST_TOKEN=

# Cota diaria do Resend, compartilhada entre a regua do Circle e o evento
# (100 no plano gratis, 1500 no Pro). Os ultimos 10 do dia ficam para alerta.
RESEND_DAILY_BUDGET=

# Automacao pos-compra da Imersao (Marco 1).
# live = e-mail vai para o comprador de verdade. Qualquer outro valor, ou
# vazio, e sandbox: comprador real nao recebe nada (o job espera pendente) e
# comprador do produto de teste recebe na allowlist. Fechado por padrao.
EVENTO_MODE=
# Nota: virar live nao reenvia sozinho as T0 que ficaram pendentes; elas saem
# no tick de e-mail do Marco 3 (docs/evento/marco-1.md, limitacoes).
# E-mails (separados por virgula) que recebem os envios do produto de teste.
# So o PRIMEIRO endereco valido recebe; os outros sao ignorados.
EVENTO_SANDBOX_ALLOWLIST=
# Ids de produto da Kiwify tratados como "Ingresso TESTE" (source=sandbox).
EVENTO_TEST_PRODUCT_IDS=
# Segredo do HMAC do link pessoal da pesquisa (?t=<buyer_id>.<hmac>). Minimo
# de 32 caracteres; sem ele a T0 por e-mail nao sai (fica pendente). Gerar
# fora do chat (ex.: openssl rand -base64 48) e por direto na Vercel.
# O link nao expira: trocar o segredo invalida TODOS os links ja enviados na
# T0 (a pesquisa ainda funciona pelo e-mail). Trocar so se vazar.
EVENTO_LINK_SECRET=
